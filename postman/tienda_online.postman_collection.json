{
  "info": {
    "name": "Tienda Online - API de pedidos",
    "description": "Coleccion del parcial de gestion de base de datos. Ejecutar en orden: crea producto y cliente, guarda sus ids y los usa en el pedido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "producto_id", "value": "" },
    { "key": "cliente_id", "value": "" },
    { "key": "pedido_id", "value": "" }
  ],
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var producto = pm.response.json();",
                  "pm.collectionVariables.set('producto_id', producto._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado mecanico\",\n  \"categoria\": \"Perifericos\",\n  \"precio\": 45000,\n  \"stock\": 20\n}"
            },
            "url": {
              "raw": "{{base_url}}/productos",
              "host": ["{{base_url}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "Obtener todos los productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos",
              "host": ["{{base_url}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "Obtener un producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos/{{producto_id}}",
              "host": ["{{base_url}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        },
        {
          "name": "Modificar precio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Precio actualizado', function () { pm.expect(pm.response.json().precio).to.eql(49999); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 49999\n}"
            },
            "url": {
              "raw": "{{base_url}}/productos/{{producto_id}}",
              "host": ["{{base_url}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        },
        {
          "name": "Modificar nombre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado mecanico RGB\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/productos/{{producto_id}}",
              "host": ["{{base_url}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        },
        {
          "name": "Modificar stock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 30\n}"
            },
            "url": {
              "raw": "{{base_url}}/productos/{{producto_id}}",
              "host": ["{{base_url}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        },
        {
          "name": "Eliminar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/productos/{{producto_id}}",
              "host": ["{{base_url}}"],
              "path": ["productos", "{{producto_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Crear cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var cliente = pm.response.json();",
                  "pm.collectionVariables.set('cliente_id', cliente._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Maria\",\n  \"apellido\": \"Gomez\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/clientes",
              "host": ["{{base_url}}"],
              "path": ["clientes"]
            }
          }
        },
        {
          "name": "Obtener todos los clientes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/clientes",
              "host": ["{{base_url}}"],
              "path": ["clientes"]
            }
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Crear pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "var pedido = pm.response.json();",
                  "pm.collectionVariables.set('pedido_id', pedido._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": \"{{cliente_id}}\",\n  \"items\": [\n    { \"producto_id\": \"{{producto_id}}\", \"cantidad\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/pedidos",
              "host": ["{{base_url}}"],
              "path": ["pedidos"]
            }
          }
        },
        {
          "name": "Obtener pedidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pedidos",
              "host": ["{{base_url}}"],
              "path": ["pedidos"]
            }
          }
        }
      ]
    }
  ]
}
